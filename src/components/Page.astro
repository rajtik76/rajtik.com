---
import type { Content } from '../i18n/en';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const site = 'https://rajtik.com';

const packages = [
  { name: 'captchaapi/laravel', href: 'https://github.com/captchaapi/laravel',  reg: 'Composer · Packagist' },
  { name: 'captchaapi',         href: 'https://wordpress.org/plugins/captchaapi/', reg: t.packageReg.wordpress },
  { name: 'poe2-toolkit',       href: 'https://github.com/rajtik76/poe2-toolkit', reg: 'npm · GitHub', extra: '@poe2-toolkit/ggpk' },
];

const releaseCode = `public function activate(string $version): void
{
    if (! $this->has($version)) {
        throw new RuntimeException("release {$version} is not staged");
    }

    $tmp = $this->currentLink().'.'.bin2hex(random_bytes(4));

    if (! @symlink("releases/{$version}", $tmp)) {
        throw new RuntimeException("could not create the swap symlink at {$tmp}");
    }

    if (! @rename($tmp, $this->currentLink())) {
        @unlink($tmp);

        throw new RuntimeException('could not swap the current symlink');
    }
}`;

const escapeHtml = (value: string) => value
  .replaceAll('&', '&amp;')
  .replaceAll('<', '&lt;')
  .replaceAll('>', '&gt;');

const highlightPhp = (code: string) => {
  const tokens = /(?<comment>\/\/.*$)|(?<string>'(?:\\.|[^'\\])*'|"(?:\\.|[^"\\])*")|(?<variable>\$[A-Za-z_]\w*)|(?<keyword>\b(?:final|class|implements|public|function|string|mixed|void|if|return|try|catch|throw|new)\b)|(?<type>\b(?:RuntimeException)\b)|(?<number>\b\d+\b)/gm;
  let result = '';
  let index = 0;

  for (const match of code.matchAll(tokens)) {
    result += escapeHtml(code.slice(index, match.index));
    const kind = Object.entries(match.groups ?? {}).find(([, value]) => value)?.[0];
    result += `<span class="tok-${kind}">${escapeHtml(match[0])}</span>`;
    index = (match.index ?? 0) + match[0].length;
  }

  return result + escapeHtml(code.slice(index));
};

const highlightedReleaseCode = highlightPhp(releaseCode);
---


<!doctype html>
<html lang={t.lang}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{t.title}</title>
<meta name="description" content={t.description} />
<link rel="canonical" href={`${site}${t.path}`} />
<link rel="alternate" hreflang="en" href={`${site}/`} />
<link rel="alternate" hreflang="cs" href={`${site}/cs/`} />
<link rel="alternate" hreflang="x-default" href={`${site}/`} />
<script is:inline define:vars={{ lang: t.lang }}>
  let saved = null;
  try { saved = localStorage.getItem('lang'); } catch {}
  let target = saved;
  if (!target && lang === 'en') {
    const first = (navigator.languages || [navigator.language])
      .map((l) => l.toLowerCase().slice(0, 2))
      .find((l) => ['cs', 'sk', 'en'].includes(l));
    target = first === 'cs' || first === 'sk' ? 'cs' : 'en';
  }
  if (target && target !== lang) location.replace(target === 'cs' ? '/cs/' : '/');
</script>
<meta property="og:title" content={t.title} />
<meta property="og:description" content={t.description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={`${site}${t.path}`} />
<meta property="og:locale" content={t.locale} />
<meta property="og:image" content="https://rajtik.com/og.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={t.title} />
<meta name="twitter:description" content={t.description} />
<meta name="twitter:image" content="https://rajtik.com/og.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet" />
</head>
<body>
<main class="term">
  <div class="bar">
    <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
    <span class="path">vladislav@rajtik: ~/about</span>
    <nav class="lang" aria-label="Language">
      <a href="/cs/" hreflang="cs" data-lang="cs" class:list={[{ active: t.lang === 'cs' }]} aria-current={t.lang === 'cs' ? 'page' : undefined}>CZ</a><span class="sep">|</span><a href="/" hreflang="en" data-lang="en" class:list={[{ active: t.lang === 'en' }]} aria-current={t.lang === 'en' ? 'page' : undefined}>EN</a>
    </nav>
  </div>
  <div class="body">

    <p class="pr"><b>vladislav@rajtik</b>:<span class="tilde">~</span>$ <span class="cmd">whoami</span></p>
    <div class="blk">
      <h1>Vladislav Rajtmajer</h1>
      <p class="role">{t.role}</p>
      <p class="meta">{t.meta}</p>
      <p class="avail"><span class="ok"></span> {t.avail}</p>
    </div>

    <p class="pr"><b>vladislav@rajtik</b>:<span class="tilde">~</span>$ <span class="cmd">cat <span class="flag">about.md</span></span></p>
    <div class="blk out">
      {t.about.map((p) => <>{p}<br /><br /></>)}
      <span class="dim">{t.aboutNote}</span>
    </div>

    <p class="pr"><b>vladislav@rajtik</b>:<span class="tilde">~</span>$ <span class="cmd">cat <span class="flag">ai.md</span> --in-production</span></p>
    <div class="blk">
      {t.ai.map((a) => (
        <div class="ai">
          <span class="nm"><a href={a.href}>{a.name}</a></span>
          <span class="tg">{a.tag}</span>
          <span class="de">{a.desc}</span>
        </div>
      ))}
    </div>

    <p class="pr"><b>vladislav@rajtik</b>:<span class="tilde">~</span>$ <span class="cmd">ls <span class="flag">projects/</span></span></p>
    <div class="blk">
      <div class="grid">
        {t.projects.map((p) => (
          <article class="card">
            <h3><a href={p.href}>{p.name}</a>{p.repo && (
              <a class="repo" href={p.repo} aria-label={t.repoAria(p.name)} title={t.repoLabel}>
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
              </a>
            )}</h3><span class="tag">{p.tag}</span>
            <p>{p.body}</p>
          </article>
        ))}
      </div>
    </div>

    <p class="pr"><b>vladislav@rajtik</b>:<span class="tilde">~</span>$ <span class="cmd">cat <span class="flag">packages.json</span> --published</span></p>
    <div class="blk">
      {packages.map((p) => (
        <div class="pkg">
          <span class="name"><a href={p.href}>{p.name}</a>{p.extra && <span class="dim"> · {p.extra}</span>}</span>
          <span class="reg">{p.reg}</span>
        </div>
      ))}
      <p class="badge">{t.packagesBadge}</p>
    </div>

    <p class="pr"><b>vladislav@rajtik</b>:<span class="tilde">~</span>$ <span class="cmd">cat <span class="flag">exile2exile</span> app/Services/GameDataReleases.php</span></p>
    <div class="blk">
      <pre class="code" set:html={highlightedReleaseCode}></pre>
      <p class="meta">{t.codeCaptionPrefix} <a href="https://github.com/rajtik76/exile2exile/blob/main/app/Services/GameDataReleases.php#L81-L98">Exile to Exile</a>. {t.codeCaption}</p>
    </div>

    <p class="pr"><b>vladislav@rajtik</b>:<span class="tilde">~</span>$ <span class="cmd">git log <span class="flag">--oneline</span> --career</span></p>
    <div class="blk">
      {t.experience.map((e) => (
        <div class="exp">
          <span class="yr">{e.yr}</span>
          <span><span class="ro">{e.role}</span>{e.org && <> · <span class="co">{e.org}</span></>}</span>
          <span class="de">{e.desc}</span>
        </div>
      ))}
    </div>

    <p class="pr"><b>vladislav@rajtik</b>:<span class="tilde">~</span>$ <span class="cmd">cat <span class="flag">stack.txt</span></span></p>
    <div class="blk">
      <div class="chips">
        {t.skills.map((s) => <span class="chip">{s}</span>)}
      </div>
      <p class="meta" style="margin-top:14px">{t.languages}</p>
    </div>

    <p class="pr"><b>vladislav@rajtik</b>:<span class="tilde">~</span>$ <span class="cmd">contact <span class="flag">--now</span></span></p>
    <div class="blk out">
      <a href="mailto:vladislav.rajtmajer1@gmail.com">vladislav.rajtmajer1@gmail.com</a> ·
      <a href="https://github.com/rajtik76">github.com/rajtik76</a> ·
      <a href="https://www.linkedin.com/in/vladislavrajtmajer/">linkedin.com/in/vladislavrajtmajer</a> ·
      <a href="https://x.com/VRajtmajer">x.com/VRajtmajer</a> ·
      <a href="https://laravel-blog.cz">laravel-blog.cz</a>
    </div>

    <p class="pr"><b>vladislav@rajtik</b>:<span class="tilde">~</span>$ <span class="cmd">cv <span class="flag">--download</span></span></p>
    <div class="blk out">
      {t.cv.map((c, i) => <>{i > 0 && ' · '}<a href={c.href} download={c.download}>{c.label}</a></>)}
    </div>

    <p class="pr"><b>vladislav@rajtik</b>:<span class="tilde">~</span>$ <span class="cursor"></span></p>

  </div>
</main>
<footer>Plzeň, CZ</footer>
<script is:inline>
  document.querySelectorAll('[data-lang]').forEach((a) => a.addEventListener('click', () => {
    try { localStorage.setItem('lang', a.dataset.lang); } catch {}
  }));
</script>

<style>
  :root{
    --bg:#0c0e10; --panel:#13161a; --fg:#d8d4ca; --dim:#7d848c;
    --amber:#f0a500; --teal:#54c7ab; --line:#22272d;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    margin:0; background:var(--bg); color:var(--fg);
    font-family:"JetBrains Mono",ui-monospace,Menlo,monospace;
    font-size:15px; line-height:1.7; letter-spacing:-.1px;
    -webkit-font-smoothing:antialiased;
  }
  a{color:var(--teal); text-decoration:none; border-bottom:1px solid transparent}
  a:hover{border-bottom-color:var(--teal)}

  .term{margin:40px auto; max-width:880px; border:1px solid var(--line);
        border-radius:10px; background:var(--panel); overflow:hidden;
        box-shadow:0 30px 80px -40px #000}
  .bar{display:flex; align-items:center; gap:8px; padding:11px 16px;
       border-bottom:1px solid var(--line); background:#0f1215}
  .dot{width:11px; height:11px; border-radius:50%}
  .dot.r{background:#ff5f56} .dot.y{background:#ffbd2e} .dot.g{background:#27c93f}
  .bar .path{margin-left:10px; color:var(--dim); font-size:12.5px}
  .bar .lang{margin-left:auto; font-size:12.5px; color:var(--dim)}
  .bar .lang a{color:var(--dim)} .bar .lang a:hover{color:var(--fg)}
  .bar .lang a.active{color:var(--amber)}
  .bar .lang .sep{padding:0 6px}
  .body{padding:26px 26px 34px}

  .pr{color:var(--dim); margin:0}
  .pr b{color:var(--teal); font-weight:500}
  .pr .tilde{color:var(--amber)}
  .pr .cmd{color:var(--fg)}
  .blk{margin:6px 0 30px; padding-left:2px}
  .flag{color:var(--amber)}
  .cursor{display:inline-block; width:9px; height:1.05em; vertical-align:-2px;
          background:var(--amber); animation:blink 1.1s steps(1) infinite; margin-left:3px}
  @keyframes blink{50%{opacity:0}}

  h1{font-size:30px; margin:14px 0 2px; font-weight:700; letter-spacing:-1px}
  .role{color:var(--amber); font-size:15px; margin:0 0 4px}
  .meta{color:var(--dim); font-size:13px; margin:0 0 8px}
  .avail{font-size:13px; color:#27c93f; margin:0 0 8px}
  .ok{display:inline-block; width:8px; height:8px; border-radius:50%; background:#27c93f;
      margin-right:7px; vertical-align:1px; box-shadow:0 0 8px #27c93f}
  .out{color:var(--fg)} .dim{color:var(--dim)}

  .grid{display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:10px}
  .card{border:1px solid var(--line); border-radius:8px; padding:16px 18px; background:#0f1216}
  .card h3{margin:0 0 4px; font-size:15px; color:var(--fg)}
  .card .repo{margin-left:8px; color:var(--dim); vertical-align:-1px} .card .repo:hover{color:var(--fg)}
  .card .repo svg{display:inline-block}
  .card .tag{color:var(--teal); font-size:12px}
  .card p{margin:8px 0 0; font-size:13.5px; color:var(--dim); line-height:1.6}
  .badge{display:inline-block; font-size:11.5px; color:var(--amber);
         border:1px solid #3a2f12; background:#1a1407; padding:1px 7px; border-radius:4px; margin:10px 0 0}

  .pkg{display:flex; justify-content:space-between; gap:14px; padding:11px 0;
       border-bottom:1px dashed var(--line); flex-wrap:wrap}
  .pkg .name{color:var(--fg)} .pkg .reg{color:var(--dim); font-size:12.5px}

  .exp{display:grid; grid-template-columns:118px 1fr; gap:4px 18px; padding:9px 0; border-top:1px solid var(--line)}
  .exp:first-of-type{border-top:0}
  .exp .yr{color:var(--dim); font-size:13px}
  .exp .ro{color:var(--fg)} .exp .co{color:var(--teal); font-size:13px}
  .exp .de{color:var(--dim); font-size:13px; grid-column:2}

  .ai{display:grid; grid-template-columns:150px 1fr; gap:2px 18px; padding:10px 0; border-top:1px solid var(--line)}
  .ai:first-of-type{border-top:0}
  .ai .tg{color:var(--amber); font-size:12.5px}
  .ai .de{color:var(--dim); font-size:13px; grid-column:2; line-height:1.6}

  .code{margin:2px 0 10px; padding:16px 18px; background:#0f1216; border:1px solid var(--line);
        border-radius:8px; overflow-x:auto; font-size:12.5px; line-height:1.65; color:#c4cad0;
        white-space:pre; tab-size:4}
  .code :global(.tok-comment){color:#69737d; font-style:italic}
  .code :global(.tok-string){color:#b9d67a}
  .code :global(.tok-variable){color:#e8a96b}
  .code :global(.tok-keyword){color:#d998f0}
  .code :global(.tok-type){color:#62d2bd}
  .code :global(.tok-number){color:#f0c36b}

  .chips{display:flex; flex-wrap:wrap; gap:7px; margin-top:8px}
  .chip{font-size:12.5px; color:var(--fg); border:1px solid var(--line); padding:2px 9px; border-radius:5px; background:#0f1216}

  footer{color:var(--dim); font-size:12.5px; text-align:center; padding:26px 0 50px}

  @media(max-width:620px){
    .grid{grid-template-columns:1fr}
    .exp{grid-template-columns:1fr}
    .exp .de{grid-column:1}
    .ai{grid-template-columns:1fr}
    .ai .de{grid-column:1}
    .term{margin:20px auto; border-radius:0; border-left:0; border-right:0}
  }
</style>
</body>
</html>
