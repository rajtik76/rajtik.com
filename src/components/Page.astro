---
import type { Content } from '../i18n/en';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const site = 'https://cv.rajtik.com';

const packages = [
  { name: 'captchaapi/laravel', href: 'https://github.com/captchaapi/laravel',  reg: 'Composer · Packagist' },
  { name: 'rajtik76/nette-*',   href: 'https://packagist.org/packages/rajtik76/', reg: 'Composer · Packagist' },
  { name: 'captchaapi',         href: 'https://wordpress.org/plugins/captchaapi/', reg: t.packageReg.wordpress },
  { name: 'poe2-toolkit',       href: 'https://github.com/rajtik76/poe2-toolkit', reg: 'npm · GitHub' },
];

const releaseCode = `public function activate(string $version): void
{
    if (! $this->has($version)) {
        throw new RuntimeException("release {$version} is not staged");
    }

    $tmp = $this->currentLink().'.'.bin2hex(random_bytes(4));

    if (! @symlink("releases/{$version}", $tmp)) {
        throw new RuntimeException("could not create the swap symlink at {$tmp}");
    }

    if (! @rename($tmp, $this->currentLink())) {
        @unlink($tmp);

        throw new RuntimeException('could not swap the current symlink');
    }
}`;

const escapeHtml = (value: string) => value
  .replaceAll('&', '&amp;')
  .replaceAll('<', '&lt;')
  .replaceAll('>', '&gt;');

const highlightPhp = (code: string) => {
  const tokens = /(?<comment>\/\/.*$)|(?<string>'(?:\\.|[^'\\])*'|"(?:\\.|[^"\\])*")|(?<variable>\$[A-Za-z_]\w*)|(?<keyword>\b(?:final|class|implements|public|function|string|mixed|void|if|return|try|catch|throw|new)\b)|(?<type>\b(?:RuntimeException)\b)|(?<number>\b\d+\b)/gm;
  let result = '';
  let index = 0;

  for (const match of code.matchAll(tokens)) {
    result += escapeHtml(code.slice(index, match.index));
    const kind = Object.entries(match.groups ?? {}).find(([, value]) => value)?.[0];
    result += `<span class="tok-${kind}">${escapeHtml(match[0])}</span>`;
    index = (match.index ?? 0) + match[0].length;
  }

  return result + escapeHtml(code.slice(index));
};

const highlightedReleaseCode = highlightPhp(releaseCode);
---


<!doctype html>
<html lang={t.lang}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{t.title}</title>
<meta name="description" content={t.description} />
<link rel="canonical" href={`${site}${t.path}`} />
<link rel="alternate" hreflang="en" href={`${site}/`} />
<link rel="alternate" hreflang="cs" href={`${site}/cs/`} />
<link rel="alternate" hreflang="x-default" href={`${site}/`} />
<script is:inline define:vars={{ lang: t.lang }}>
  let saved = null;
  try { saved = localStorage.getItem('lang'); } catch {}
  let target = saved;
  if (!target && lang === 'en') {
    const first = (navigator.languages || [navigator.language])
      .map((l) => l.toLowerCase().slice(0, 2))
      .find((l) => ['cs', 'sk', 'en'].includes(l));
    target = first === 'cs' || first === 'sk' ? 'cs' : 'en';
  }
  if (target && target !== lang) location.replace(target === 'cs' ? '/cs/' : '/');
</script>
<meta property="og:title" content={t.title} />
<meta property="og:description" content={t.description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={`${site}${t.path}`} />
<meta property="og:locale" content={t.locale} />
<meta property="og:image" content="https://cv.rajtik.com/og.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={t.title} />
<meta name="twitter:description" content={t.description} />
<meta name="twitter:image" content="https://cv.rajtik.com/og.png" />
<script is:inline defer src="https://stats.rajtik.com/script.js" data-website-id="0ea9f981-3509-49b1-a820-55034e93a1ab" data-domains="cv.rajtik.com"></script>
<link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet" />
</head>
<body>
<main class="term">
  <div class="bar">
    <span class="path">cv.rajtik.com</span>
    <nav class="lang" aria-label="Language">
      <a href="/cs/" hreflang="cs" data-lang="cs" class:list={[{ active: t.lang === 'cs' }]} aria-current={t.lang === 'cs' ? 'page' : undefined}>CZ</a><span class="sep">|</span><a href="/" hreflang="en" data-lang="en" class:list={[{ active: t.lang === 'en' }]} aria-current={t.lang === 'en' ? 'page' : undefined}>EN</a>
    </nav>
  </div>
  <div class="body">

    <div class="blk">
      <h1 class="brand"><span class="first">Vladislav</span> <img src="/brand/rajtmajer-wordmark-white.svg" alt="Rajtmajer" width="182" height="50" /></h1>
      <p class="role">{t.role}</p>
      <p class="meta">{t.meta}</p>
      <p class="avail"><span class="ok"></span> {t.avail}</p>
      <p class="hero-actions"><a href="mailto:vladislav.rajtmajer1@gmail.com">{t.contactCta}</a><a href={t.cv[0].href} download={t.cv[0].download}>{t.cv[0].label}</a></p>
    </div>

    <h2 class="section-heading">{t.headings.about}</h2>
    <div class="blk out intro">
      {t.about.map((p) => <p>{p}</p>)}
      <p class="about-note">{t.aboutNote}</p>
    </div>

    <h2 class="section-heading">{t.headings.experience}</h2>
    <div class="blk">
      {t.experience.map((e) => (
        <div class="exp">
          <span class="yr">{e.yr}</span>
          <span><span class="ro">{e.role}</span>{e.org && <> · <span class="co">{e.org}</span></>}</span>
          <span class="de">{e.desc}</span>
        </div>
      ))}
    </div>

    <h2 class="section-heading">{t.headings.ai}</h2>
    <div class="blk">
      {t.ai.map((a) => (
        <div class="ai">
          <span class="nm"><a href={a.href}>{a.name}</a></span>
          <span class="tg">{a.tag}</span>
          <span class="de">{a.desc}</span>
        </div>
      ))}
    </div>

    <h2 class="section-heading">{t.headings.projects}</h2>
    <div class="blk">
      <div class="grid">
        {t.projects.map((p) => (
          <article class="card">
            <h3><a href={p.href}>{p.name}</a>{p.repo && (
              <a class="repo" href={p.repo} aria-label={t.repoAria(p.name)} title={t.repoLabel}>
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
              </a>
            )}</h3><span class="tag">{p.tag}</span>
            <p>{p.body}</p>
          </article>
        ))}
      </div>
    </div>

    <h2 class="section-heading">{t.headings.packages}</h2>
    <div class="blk">
      {packages.map((p) => (
        <div class="pkg">
          <span class="name"><a href={p.href}>{p.name}</a></span>
          <span class="reg">{p.reg}</span>
        </div>
      ))}
      <p class="badge">{t.packagesBadge}</p>
    </div>

    <h2 class="section-heading">{t.headings.code}</h2>
    <div class="blk">
      <pre class="code" set:html={highlightedReleaseCode}></pre>
      <p class="meta">{t.codeCaptionPrefix} <a href="https://github.com/rajtik76/exile2exile/blob/main/app/Services/GameDataReleases.php#L81-L98">Exile to Exile</a>. {t.codeCaption}</p>
    </div>

    <h2 class="section-heading">{t.headings.skills}</h2>
    <div class="blk">
      <div class="chips">
        {t.skills.map((s) => <span class="chip">{s}</span>)}
      </div>
      <p class="meta" style="margin-top:14px">{t.languages}</p>
    </div>

    <h2 class="section-heading">{t.headings.contact}</h2>
    <ul class="blk contact-list">
      <li><a class="contact-link" href="mailto:vladislav.rajtmajer1@gmail.com">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m3.5 6 8.5 7 8.5-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span class="contact-copy"><strong>E-mail</strong><span>vladislav.rajtmajer1@gmail.com</span></span>
      </a></li>
      <li><a class="contact-link" href="https://github.com/rajtik76">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .8a11.2 11.2 0 0 0-3.54 21.83c.56.1.76-.24.76-.54v-2.1c-3.1.67-3.76-1.32-3.76-1.32-.5-1.28-1.24-1.62-1.24-1.62-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 .1 1.58-.72 1.9-1.1.1-.73.39-1.23.7-1.51-2.48-.28-5.09-1.24-5.09-5.53 0-1.22.44-2.21 1.15-2.99-.11-.28-.5-1.42.11-2.96 0 0 .94-.3 3.08 1.14A10.7 10.7 0 0 1 12 6.42c.95 0 1.9.13 2.8.38 2.14-1.44 3.07-1.14 3.07-1.14.61 1.54.23 2.68.12 2.96.72.78 1.14 1.77 1.14 2.99 0 4.3-2.62 5.25-5.11 5.53.4.35.75 1.04.75 2.1v2.85c0 .3.2.65.77.54A11.2 11.2 0 0 0 12 .8Z"/></svg>
        <span class="contact-copy"><strong>GitHub</strong><span>github.com/rajtik76</span></span>
      </a></li>
      <li><a class="contact-link" href="https://www.linkedin.com/in/vladislavrajtmajer/">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4.7 3a2.2 2.2 0 1 1 0 4.4 2.2 2.2 0 0 1 0-4.4ZM2.9 9h3.6v12H2.9V9Zm5.8 0h3.5v1.6h.1a3.8 3.8 0 0 1 3.4-1.9c3.7 0 4.4 2.4 4.4 5.5V21h-3.7v-6c0-1.5 0-3.3-2-3.3s-2.3 1.6-2.3 3.2V21H8.7V9Z"/></svg>
        <span class="contact-copy"><strong>LinkedIn</strong><span>linkedin.com/in/vladislavrajtmajer</span></span>
      </a></li>
      <li><a class="contact-link" href="https://x.com/VRajtmajer">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17.8 2H21l-7 8 8.2 12h-6.5l-5.1-7.4L4.1 22H.9l7.5-8.6L.6 2h6.5l4.6 6.8L17.8 2Zm-1.1 18h1.8L6.1 3.9H4.2L16.7 20Z"/></svg>
        <span class="contact-copy"><strong>X</strong><span>x.com/VRajtmajer</span></span>
      </a></li>
      <li><a class="contact-link" href="https://rajtik.com">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="2.5" width="8" height="8" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="13.5" y="2.5" width="8" height="8" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="2.5" y="13.5" width="8" height="8" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="13.5" y="13.5" width="8" height="8" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
        <span class="contact-copy"><strong>{t.hubLabel}</strong><span>rajtik.com</span></span>
      </a></li>
    </ul>

    <h2 class="section-heading">{t.headings.cv}</h2>
    <div class="blk out">
      {t.cv.map((c, i) => <>{i > 0 && ' · '}<a href={c.href} download={c.download} data-umami-event="cv-download" data-umami-event-file={c.href}>{c.label}</a></>)}
    </div>


  </div>
</main>
<footer>Plzeň, CZ</footer>
<script is:inline>
  document.querySelectorAll('[data-lang]').forEach((a) => a.addEventListener('click', () => {
    try { localStorage.setItem('lang', a.dataset.lang); } catch {}
  }));
</script>

<style>
  :root{
    --bg:#0c0e10; --panel:#13161a; --fg:#d8d4ca; --dim:#7d848c;
    --amber:#f0a500; --teal:#54c7ab; --line:#22272d;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    margin:0; background:var(--bg); color:var(--fg);
    font-family:system-ui,-apple-system,"Segoe UI",sans-serif;
    font-size:16px; line-height:1.65;
    -webkit-font-smoothing:antialiased;
  }
  a{color:var(--teal); text-decoration:none; border-bottom:1px solid transparent}
  a:hover{border-bottom-color:var(--teal)}
  a:focus-visible{outline:2px solid var(--amber); outline-offset:3px}

  .term{margin:40px auto; max-width:880px; border:1px solid var(--line);
        border-radius:10px; background:var(--panel); overflow:hidden;
        box-shadow:0 30px 80px -40px #000}
  .bar{display:flex; align-items:center; gap:8px; padding:13px 26px;
       border-bottom:1px solid var(--line); background:#0f1215}
  .bar .path{color:var(--fg); font-size:13px; font-weight:600}
  .bar .lang{margin-left:auto; font:500 12.5px "JetBrains Mono",monospace; color:var(--dim)}
  .bar .lang a{color:var(--dim)} .bar .lang a:hover{color:var(--fg)}
  .bar .lang a.active{color:var(--amber)}
  .bar .lang .sep{padding:0 6px}
  .body{padding:28px 34px 40px}
  .blk{margin:0 0 30px}
  .section-heading{font-size:21px; line-height:1.3; font-weight:650; letter-spacing:-.02em;
                   margin:44px 0 14px; padding-bottom:9px; border-bottom:1px solid #384047; color:var(--fg)}
  .intro{max-width:72ch}
  .intro p{margin:0 0 14px}
  .intro .about-note{color:var(--teal); font-weight:600; margin-top:20px}

  h1{font-size:30px; margin:14px 0 2px; font-weight:700; letter-spacing:-1px}
  h1.brand{display:grid; justify-items:start; gap:1px; margin:10px 0 12px}
  h1.brand .first{font-size:25px; font-weight:600; letter-spacing:-.035em; color:var(--fg)}
  h1.brand img{display:block; height:50px; width:auto; margin-left:-3px}
  .role{color:var(--amber); font-size:19px; font-weight:600; margin:0 0 6px}
  .meta{color:var(--dim); font-size:14px; margin:0 0 8px}
  .avail{font-size:14px; color:#49d16c; margin:0 0 8px}
  .hero-actions{display:flex; flex-wrap:wrap; gap:8px; margin:14px 0 0}
  .hero-actions a{display:inline-block; border:1px solid var(--teal); border-radius:5px; padding:7px 13px; font-size:13px; font-weight:600}
  .hero-actions a:first-child{background:var(--teal); color:#0c0e10}
  .ok{display:inline-block; width:8px; height:8px; border-radius:50%; background:#27c93f;
      margin-right:7px; vertical-align:1px; box-shadow:0 0 8px #27c93f}
  .out{color:var(--fg)} .dim{color:var(--dim)}

  .grid{display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:10px}
  .card{border:1px solid var(--line); border-radius:8px; padding:16px 18px; background:#0f1216}
  .card h3{margin:0 0 4px; font-size:17px; color:var(--fg)}
  .card .repo{margin-left:8px; color:var(--dim); vertical-align:-1px} .card .repo:hover{color:var(--fg)}
  .card .repo svg{display:inline-block}
  .card .tag{color:var(--teal); font-size:13px}
  .card p{margin:8px 0 0; font-size:14px; color:var(--dim); line-height:1.6}
  .badge{display:inline-block; font-size:11.5px; color:var(--amber);
         border:1px solid #3a2f12; background:#1a1407; padding:1px 7px; border-radius:4px; margin:10px 0 0}

  .pkg{display:flex; justify-content:space-between; gap:14px; padding:11px 0;
       border-bottom:1px dashed var(--line); flex-wrap:wrap}
  .pkg .name{color:var(--fg)} .pkg .reg{color:var(--dim); font-size:12.5px}

  .exp{display:grid; grid-template-columns:118px 1fr; gap:4px 18px; padding:9px 0; border-top:1px solid var(--line)}
  .exp:first-of-type{border-top:0}
  .exp .yr{color:var(--dim); font-size:14px}
  .exp .ro{color:var(--fg); font-weight:600} .exp .co{color:var(--teal); font-size:14px}
  .exp .de{color:var(--dim); font-size:14px; grid-column:2}

  .ai{display:grid; grid-template-columns:150px 1fr; gap:2px 18px; padding:10px 0; border-top:1px solid var(--line)}
  .ai:first-of-type{border-top:0}
  .ai .tg{color:var(--amber); font-size:13px}
  .ai .de{color:var(--dim); font-size:14px; grid-column:2; line-height:1.6}

  .code{margin:2px 0 10px; padding:16px 18px; background:#0f1216; border:1px solid var(--line);
        border-radius:8px; overflow-x:auto; font-size:12.5px; line-height:1.65; color:#c4cad0;
        white-space:pre; tab-size:4; font-family:"JetBrains Mono",monospace}
  .code :global(.tok-comment){color:#69737d; font-style:italic}
  .code :global(.tok-string){color:#b9d67a}
  .code :global(.tok-variable){color:#e8a96b}
  .code :global(.tok-keyword){color:#d998f0}
  .code :global(.tok-type){color:#62d2bd}
  .code :global(.tok-number){color:#f0c36b}

  .chips{display:flex; flex-wrap:wrap; gap:7px; margin-top:8px}
  .chip{font-size:12.5px; color:var(--fg); border:1px solid var(--line); padding:2px 9px; border-radius:5px; background:#0f1216}

  .contact-list{list-style:none; padding:0; max-width:630px}
  .contact-list li{border-bottom:1px solid var(--line)}
  .contact-list li:first-child{border-top:1px solid var(--line)}
  .contact-link{display:grid; grid-template-columns:28px minmax(0,1fr); gap:14px; align-items:center;
                padding:12px 10px; border:0; border-radius:4px}
  .contact-link:hover{background:#1b2226; border:0}
  .contact-link svg{width:22px; height:22px; color:var(--teal)}
  .contact-copy{min-width:0; overflow-wrap:anywhere}
  .contact-copy strong{display:block; color:var(--fg); font-size:14px; line-height:1.35}
  .contact-copy span{display:block; color:var(--dim); font-size:14px; line-height:1.5}
  .contact-link:hover .contact-copy span{color:var(--teal)}

  footer{color:var(--dim); font-size:12.5px; text-align:center; padding:26px 0 50px}

  @media(max-width:620px){
    .grid{grid-template-columns:1fr}
    .exp{grid-template-columns:1fr}
    .exp .de{grid-column:1}
    .ai{grid-template-columns:1fr}
    .ai .de{grid-column:1}
    .term{margin:0 auto; border-radius:0; border-left:0; border-right:0}
    .body{padding:22px 24px 34px}
    .bar{padding:13px 24px}
    .role{font-size:17px}
    .section-heading{margin-top:36px}
  }
</style>
</body>
</html>
